{
  "name": "@chronicle/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Mirrors Arkiv, derives versions and flags, serves the REST API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test scripts --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "dev:fake": "tsx scripts/dev-fake.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@chronicle/core": "workspace:*",
    "@fastify/multipart": "^8.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^4.28.1",
    "pino": "^10.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@chronicle/demo-site": "workspace:^",
    "@chronicle/watcher": "workspace:^",
    "@types/better-sqlite3": "^9.6.0"
  }
}
