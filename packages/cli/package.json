{
  "name": "@chronicle/cli",
  "version": "0.1.0",
  "private": true,
  "description": "chronicle verify / bundle CLI",
  "type": "module",
  "bin": {
    "chronicle": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@chronicle/core": "workspace:*",
    "commander": "^12.1.0"
  }
}
