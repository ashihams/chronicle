{
  "name": "@chronicle/demo-site",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic government site for the demo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
