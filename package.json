{
  "name": "chronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "coverage": "pnpm --filter @chronicle/core test:coverage",
    "lint": "pnpm -r lint && tsc -p tsconfig.scripts.json && prettier --check .",
    "format": "prettier --write .",
    "dev:demo": "pnpm --filter @chronicle/demo-site dev",
    "dev:watcher": "pnpm --filter @chronicle/watcher dev",
    "dev:indexer": "pnpm --filter @chronicle/indexer dev",
    "dev:web": "pnpm --filter @chronicle/web dev",
    "dev:bot": "pnpm --filter @chronicle/bot dev",
    "probe": "tsx --env-file=.env scripts/arkiv-probe.ts"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
