# Arkiv
# Compose defaults to live. Use fake only for single-process host demos (`pnpm dev:fake`).
ARKIV_MODE=live                      # live | fake (fake = in-memory, tests / pnpm dev:fake only)
ARKIV_CHAIN_ID=7738577
ARKIV_RPC_HTTP=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_RPC_WS=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
EXPLORER_BASE=https://tiramisu.explorer.arkiv.network

# Watcher A (compose service watcher-a, VANTAGE=in-vps)
WATCHER_PRIVATE_KEY=                 # HUMAN: funded Tiramisu wallet. Never commit.
# Watcher B (profile watcher-b / other host) — distinct funded key; do not put on the Azure A VM
WATCHER_B_PRIVATE_KEY=               # HUMAN: second wallet for multi-writer demo
PROBE_SECOND_PRIVATE_KEY=            # optional: used only by `pnpm probe` (may be same as WATCHER_B)
VANTAGE=in-vps                       # host-run label; compose overrides per service

WATCHLIST_PATH=./watchlist.json
WATCHLIST_URL=                       # optional: remote watchlist (used by community Docker image)
ALLOW_DEMO=                          # set to 1 only while recording demo mutations (default 0 in compose)
DATA_DIR=./data                      # watcher local state (sqlite)

# Azure / Caddy public HTTPS (see deploy/AZURE.md)
SITE_ADDRESS=                        # e.g. chronicle-demo.centralindia.cloudapp.azure.com
APP_PUBLISH=8080                     # on Azure use 127.0.0.1:8080
DEMO_PUBLISH=4000                    # on Azure use 127.0.0.1:4000
WATCHER_A_PUBLISH=8081               # on Azure use 127.0.0.1:8081

POLL_HOURS_DEFAULT=6
HEARTBEAT_HOURS=24
REQUEST_DELAY_MS_PER_HOST=5000
FETCH_TIMEOUT_MS=20000
USER_AGENT=ChronicleWatcher/1.0 (+https://github.com/OWNER/chronicle; contact: EMAIL)
OBSERVATION_TTL_DAYS=180
RENEW_WHEN_DAYS_LEFT=30
WATCHER_HEALTH_PORT=8081

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Indexer / API
PORT=8080
INDEXER_DB_PATH=./data/indexer.db
SYNC_INTERVAL_SECONDS=20
LIVENESS_INTERVAL_MINUTES=30
DISAGREE_WINDOW_MINUTES=30
BACKDATE_DAYS=7
CLOCK_SKEW_SECONDS=3600

# Bot
TELEGRAM_BOT_TOKEN=                  # HUMAN: from BotFather
API_BASE_URL=http://localhost:8080
BOT_DB_PATH=./data/bot.db
BOT_MAX_FILE_MB=10

# Demo site
DEMO_PORT=4000
DEMO_ADMIN_TOKEN=change-me
